# ============================================================
# DocuMind AI — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- LLM Provider ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_org_id_optional

# --- HuggingFace (free alternative to OpenAI) ---
HUGGINGFACEHUB_API_TOKEN=your_hf_token_here

# --- Pinecone (optional cloud vector store) ---
PINECONE_API_KEY=your_pinecone_key_here
PINECONE_ENVIRONMENT=your_pinecone_env

# --- Free Mode (no API keys required) ---
# Set to "true" to use only free, local models (HuggingFace + FAISS)
FREE_MODE=false

# --- App Settings ---
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=50
ALLOWED_ORIGINS=http://localhost:8501

# --- API Settings ---
API_KEY=your_custom_api_key_here
RATE_LIMIT_PER_MINUTE=10
API_HOST=0.0.0.0
API_PORT=8000

# --- Redis (optional caching) ---
REDIS_URL=redis://localhost:6379
USE_REDIS=false
