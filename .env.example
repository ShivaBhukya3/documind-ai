# ============================================================
# DocuMind AI — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Groq LLM (fast, free tier available) ---
GROQ_API_KEY=your_groq_api_key_here

# --- LLM Provider (optional — Groq is used by default) ---
OPENAI_API_KEY=
OPENAI_ORG_ID=

# --- HuggingFace ---
HUGGINGFACEHUB_API_TOKEN=
# Set to 1 in local dev once model is cached; set to 0 in production
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# --- AWS S3 (optional — documents stored locally if not set) ---
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-documind-bucket-name

# --- Pinecone (optional cloud vector store) ---
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# --- App Settings ---
APP_ENV=production
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=50

# --- API Security ---
API_KEY=change-this-to-a-strong-secret-key
RATE_LIMIT_PER_MINUTE=60
API_HOST=0.0.0.0
API_PORT=8000

# --- Redis (optional caching) ---
REDIS_URL=redis://localhost:6379
USE_REDIS=false
